@model APIPSI16.Models.JobApplication
@using System.Security.Claims
@{
    ViewData["Title"] = "Candidatura";

    var statusSteps = new[]
    {
        (byte)0, (byte)1, (byte)2, (byte)3, (byte)4
    };
    var statusLabels = new Dictionary<byte, (string label, string icon, string color)>
    {
        { 0, ("Enviada", "📤", "#6b7280") },
        { 1, ("Em análise", "🔍", "#0052CC") },
        { 2, ("Entrevista", "🎤", "#7c3aed") },
        { 3, ("Oferta", "🎉", "#059669") },
        { 4, ("Aceite", "✅", "#10b981") },
        { 5, ("Recusada", "❌", "#ef4444") }
    };
    var isRejected = Model.Status == 5;
    var currentStep = Array.IndexOf(statusSteps, Model.Status);
    var myId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isOwner = myId == Model.UserId.ToString();
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var isAdmin = role == "0";
    var isEmployer = role == "2";
    var canManageAsEmployer = isAdmin || isEmployer;
    var jobRoles = ViewBag.JobRoles as IEnumerable<XcelerateLinks.Mvc.Controllers.UsersController.LookupItem>
        ?? Array.Empty<XcelerateLinks.Mvc.Controllers.UsersController.LookupItem>();
}

<style>
    .app-detail-container { max-width: 820px; margin: 0 auto; padding: 2rem 0; }
    .app-detail-card {
        background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px; padding: 2rem; margin-bottom: 1.25rem;
    }
    .app-detail-card h4 { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--dark-text-muted,#a8b2c1); margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(255,255,255,0.07); }
    .app-job-header { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.5rem; }
    .app-job-logo {
        width: 64px; height: 64px; border-radius: 14px; flex-shrink: 0;
        background: linear-gradient(135deg,rgba(0,82,204,0.2),rgba(0,221,85,0.1));
        display: flex; align-items: center; justify-content: center; font-size: 1.6rem;
    }
    .app-job-title { font-size: 1.25rem; font-weight: 800; margin-bottom: 0.2rem; }
    .app-job-company { font-size: 0.9rem; color: var(--dark-text-muted,#a8b2c1); }

    .app-status-badge {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.35rem 1rem;
        border-radius: 30px; font-size: 0.88rem; font-weight: 600; border: 1px solid;
        margin-bottom: 1.5rem;
    }

    /* Progress stepper */
    .stepper { display: flex; gap: 0; margin-bottom: 2rem; }
    .step {
        flex: 1; display: flex; flex-direction: column; align-items: center; position: relative;
    }
    .step:not(:last-child)::after {
        content: ''; position: absolute; top: 16px; left: 50%; width: 100%; height: 2px;
        background: rgba(255,255,255,0.1); z-index: 0;
    }
    .step.done:not(:last-child)::after { background: #0052CC; }
    .step-circle {
        width: 32px; height: 32px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.15);
        background: rgba(255,255,255,0.04); display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem; font-weight: 700; z-index: 1; position: relative;
        transition: background 0.2s, border-color 0.2s;
    }
    .step.done .step-circle { background: #0052CC; border-color: #0052CC; color: #fff; }
    .step.current .step-circle { background: rgba(0,82,204,0.15); border-color: #0052CC; color: #4f8ef7; box-shadow: 0 0 0 4px rgba(0,82,204,0.15); }
    .step-label { font-size: 0.7rem; color: var(--dark-text-muted,#a8b2c1); margin-top: 0.4rem; text-align: center; }
    .step.current .step-label { color: #4f8ef7; font-weight: 600; }
    .step.done .step-label { color: #a8b2c1; }

    .detail-row { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.88rem; margin-bottom: 0.6rem; }
    .detail-row .label { color: var(--dark-text-muted,#a8b2c1); min-width: 145px; flex-shrink: 0; }

    .app-actions-bar { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .btn-primary-soft {
        background: #0052CC; color: #fff; border: none; border-radius: 30px;
        padding: 0.5rem 1.4rem; font-size: 0.88rem; text-decoration: none; display: inline-block;
        cursor: pointer;
    }
    .btn-primary-soft:hover { background: #0040A0; color: #fff; }
    .btn-outline-soft {
        background: transparent; border: 1px solid rgba(255,255,255,0.15); color: inherit;
        border-radius: 30px; padding: 0.5rem 1.4rem; font-size: 0.88rem; text-decoration: none; display: inline-block;
    }
    .btn-outline-soft:hover { background: rgba(255,255,255,0.06); color: inherit; }
    .btn-danger-soft {
        background: transparent; border: 1px solid rgba(239,68,68,0.4); color: #ef4444;
        border-radius: 30px; padding: 0.5rem 1.4rem; font-size: 0.88rem; text-decoration: none; display: inline-block;
        cursor: pointer;
    }
    .btn-danger-soft:hover { background: rgba(239,68,68,0.08); color: #ef4444; }

    .cover-letter-box {
        background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px; padding: 1rem 1.1rem; font-size: 0.88rem; line-height: 1.65;
        white-space: pre-wrap; color: inherit;
    }
    .tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .tag { background: rgba(0,82,204,0.15); border: 1px solid rgba(0,82,204,0.3); border-radius: 20px; padding: 0.15rem 0.6rem; font-size: 0.78rem; color: #93c5fd; }
    .tag-muted { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); border-radius: 20px; padding: 0.15rem 0.6rem; font-size: 0.78rem; }

    /* Interview rounds */
    .interview-round {
        background: rgba(124,58,237,0.07); border: 1px solid rgba(124,58,237,0.2);
        border-radius: 10px; padding: 1rem 1.1rem; margin-bottom: 0.6rem;
    }
    .interview-round-header { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.4rem; }
    .round-badge { background: rgba(124,58,237,0.3); border-radius: 20px; padding: 0.1rem 0.6rem; font-size: 0.75rem; }

    /* Employer action section */
    .employer-action-section { padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.07); }
    .action-btn-group { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: flex-start; margin-top: 0.75rem; }
    .notes-textarea {
        width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12);
        border-radius: 10px; color: inherit; padding: 0.65rem 0.85rem; font-size: 0.85rem;
        resize: vertical; min-height: 70px; margin-top: 0.5rem;
    }
    .notes-textarea:focus { border-color: #0052CC; outline: none; }
    .notes-label { font-size: 0.8rem; color: var(--dark-text-muted,#a8b2c1); margin-bottom: 0.25rem; }

    /* Timeline */
    .timeline { position: relative; padding-left: 1.5rem; }
    .timeline::before { content:''; position:absolute; left:7px; top:6px; bottom:6px; width:2px; background: rgba(255,255,255,0.08); }
    .tl-item { position: relative; margin-bottom: 1rem; }
    .tl-dot { position: absolute; left: -1.5rem; top: 4px; width: 14px; height: 14px; border-radius: 50%; border: 2px solid; background: #0f1420; }
    .tl-content { font-size: 0.85rem; }
    .tl-time { font-size: 0.75rem; color: var(--dark-text-muted,#a8b2c1); margin-top: 0.1rem; }
    .tl-notes { background: rgba(255,255,255,0.03); border-left: 2px solid rgba(255,255,255,0.15); padding: 0.4rem 0.7rem; border-radius: 0 6px 6px 0; margin-top: 0.35rem; font-size: 0.82rem; color: var(--dark-text-muted,#a8b2c1); }
</style>

<div class="app-detail-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-3">✅ @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3">⚠️ @TempData["ErrorMessage"]</div>
    }

    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-4">← As minhas candidaturas</a>

    <!-- Header Card -->
    <div class="app-detail-card">
        <div class="app-job-header">
            <div class="app-job-logo">🏢</div>
            <div>
                <div class="app-job-title">@(Model.Opportunity?.Title ?? $"Oportunidade #{Model.OpportunityId}")</div>
                <div class="app-job-company">@(Model.Opportunity?.Company?.Name ?? "")</div>
                @if (!string.IsNullOrEmpty(Model.Opportunity?.Location))
                {
                    <div class="app-job-company">📍 @Model.Opportunity.Location</div>
                }
            </div>
        </div>

        @{
            var (label, icon, color) = statusLabels.ContainsKey(Model.Status) ? statusLabels[Model.Status] : ("Desconhecido", "?", "#6b7280");
        }
        <div class="app-status-badge" style="color: @color; background: @(color)18; border-color: @(color)55;">
            @icon @label
        </div>

        @if (!isRejected)
        {
            <div class="stepper">
                @for (int i = 0; i < statusSteps.Length; i++)
                {
                    var step = statusSteps[i];
                    var stepInfo = statusLabels[step];
                    var isDone = currentStep >= 0 && i < currentStep;
                    var isCurrent = i == currentStep;
                    var cssClass = isDone ? "step done" : (isCurrent ? "step current" : "step");

                    <div class="@cssClass">
                        <div class="step-circle">@(isDone ? "✓" : (i + 1).ToString())</div>
                        <div class="step-label">@stepInfo.label</div>
                    </div>
                }
            </div>
        }

        <!-- Key dates -->
        <div class="mb-0">
            <div class="detail-row">
                <span class="label">Candidatado em</span>
                <span>@Model.AppliedAt.ToString("d MMMM yyyy, HH:mm")</span>
            </div>
            @if (Model.UpdatedAt.HasValue)
            {
                <div class="detail-row">
                    <span class="label">Última atualização</span>
                    <span>@Model.UpdatedAt.Value.ToString("d MMMM yyyy, HH:mm")</span>
                </div>
            }
            @if (Model.ApplicantResponse.HasValue)
            {
                <div class="detail-row">
                    <span class="label">Resposta do candidato</span>
                    @if (Model.ApplicantResponse == 1)
                    {
                        <span style="color:#10b981;font-weight:600;">✅ Aceite</span>
                    }
                    else if (Model.ApplicantResponse == 2)
                    {
                        <span style="color:#ef4444;font-weight:600;">❌ Recusado</span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Applicant submitted information -->
    <div class="app-detail-card">
        <h4>📋 Informação submetida</h4>
        @if (!string.IsNullOrEmpty(Model.Name))
        {
            <div class="detail-row">
                <span class="label">Nome</span>
                <span>@Model.Name</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
        {
            <div class="detail-row">
                <span class="label">Telefone</span>
                <span><a href="tel:@Model.PhoneNumber" style="color:inherit;">@Model.PhoneNumber</a></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.ProfessionalUrl))
        {
            <div class="detail-row">
                <span class="label">Professional Profile</span>
                <span><a href="@Model.ProfessionalUrl" target="_blank" rel="noopener" style="color:#60a5fa;">@Model.ProfessionalUrl</a></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.PortfolioUrl))
        {
            <div class="detail-row">
                <span class="label">Portfólio</span>
                <span><a href="@Model.PortfolioUrl" target="_blank" rel="noopener" style="color:#60a5fa;">@Model.PortfolioUrl</a></span>
            </div>
        }
        @if (Model.YearsOfExperience.HasValue)
        {
            <div class="detail-row">
                <span class="label">Anos de experiência</span>
                <span>@Model.YearsOfExperience ano(s)</span>
            </div>
        }
        @if (Model.OpenToRemote.HasValue)
        {
            <div class="detail-row">
                <span class="label">Disponível para remoto</span>
                <span>@(Model.OpenToRemote.Value ? "✅ Sim" : "❌ Não")</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SelectedJobRoleIds))
        {
            <div class="detail-row">
                <span class="label">Áreas de trabalho</span>
                <div class="tag-list">
                    @{
                        var selectedIds = Model.SelectedJobRoleIds.Split(',', StringSplitOptions.RemoveEmptyEntries);
                        var jobRoleList = jobRoles.ToList();
                        foreach (var rid in selectedIds)
                        {
                            if (int.TryParse(rid.Trim(), out var roleId))
                            {
                                var jrName = jobRoleList.FirstOrDefault(j => j.Id == roleId)?.Name ?? $"#{roleId}";
                                <span class="tag">@jrName</span>
                            }
                        }
                    }
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.CoverLetter))
        {
            <div style="margin-top: 1rem;">
                <div class="label" style="font-size:0.8rem;color:var(--dark-text-muted,#a8b2c1);margin-bottom:0.5rem;">Carta de apresentação</div>
                <div class="cover-letter-box">@Model.CoverLetter</div>
            </div>
        }
        else
        {
            <div class="detail-row" style="color:var(--dark-text-muted,#a8b2c1);font-style:italic;">Sem carta de apresentação.</div>
        }
    </div>

    @* Employer message to applicant *@
    @if (!string.IsNullOrEmpty(Model.LatestEmployerMessage))
    {
        <div class="app-detail-card" style="border-color: rgba(0,82,204,0.3);">
            <h4>💬 Mensagem do Recrutador</h4>
            <div class="cover-letter-box" style="border-left: 3px solid #0052CC; background: rgba(0,82,204,0.06);">@Model.LatestEmployerMessage</div>
        </div>
    }

    <!-- Interview Rounds -->
    @if (Model.InterviewRounds != null && Model.InterviewRounds.Any())
    {
        <div class="app-detail-card">
            <h4>🎤 Rondas de Entrevista</h4>
            @foreach (var round in Model.InterviewRounds.OrderBy(r => r.RoundNumber))
            {
                <div class="interview-round">
                    <div class="interview-round-header">
                        <span class="round-badge">Ronda @round.RoundNumber</span>
                        @if (round.ScheduledAt.HasValue)
                        {
                            <span>📅 @round.ScheduledAt.Value.ToString("d MMMM yyyy, HH:mm")</span>
                        }
                        @if (round.Outcome.HasValue)
                        {
                            var outcomeLabel = round.Outcome switch { 1 => ("✅ Aprovado", "#10b981"), 2 => ("❌ Reprovado", "#ef4444"), _ => ("⏳ Pendente", "#f59e0b") };
                            <span style="color:@outcomeLabel.Item2;font-size:0.8rem;">@outcomeLabel.Item1</span>
                        }
                    </div>
                    @if (round.InterviewerUser != null)
                    {
                        <div class="detail-row" style="margin-bottom:0.3rem;">
                            <span class="label" style="min-width:110px;">Entrevistador</span>
                            <span>@(round.InterviewerUser.Name ?? $"Utilizador #{round.InterviewerUserId}")</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(round.Notes))
                    {
                        <div style="margin-top:0.4rem;">
                            <div style="font-size:0.78rem;color:var(--dark-text-muted,#a8b2c1);margin-bottom:0.25rem;">Notas da ronda</div>
                            <div class="tl-notes">@round.Notes</div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Actions -->
    <div class="app-detail-card">
        <h4>⚡ Ações</h4>
        <div class="app-actions-bar">
            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn-primary-soft">Ver oportunidade</a>
            @if (isOwner && (Model.Status == 0 || Model.Status == 1))
            {
                <a asp-action="Delete" asp-route-id="@Model.JobApplicationId" class="btn-danger-soft">Retirar candidatura</a>
            }

            @* Applicant responds to interview invitation *@
            @if (isOwner && Model.Status == 2 && !Model.ApplicantResponse.HasValue)
            {
                <div style="width:100%;margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08);">
                    <div style="font-size:0.82rem;color:var(--dark-text-muted,#a8b2c1);margin-bottom:0.6rem;">Foi convidado para uma entrevista. Como prefere responder?</div>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                        <form asp-action="ApplicantRespond" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="response" value="1" />
                            <button type="submit" class="btn-primary-soft" style="background:#059669;">✓ Confirmar entrevista</button>
                        </form>
                        <form asp-action="ApplicantRespond" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="response" value="2" />
                            <button type="submit" class="btn-danger-soft">✗ Recusar entrevista</button>
                        </form>
                    </div>
                </div>
            }

            @* Applicant responds to offer *@
            @if (isOwner && Model.Status == 3 && !Model.ApplicantResponse.HasValue)
            {
                <div style="width:100%;margin-top:0.75rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.08);">
                    <div style="font-size:0.82rem;color:var(--dark-text-muted,#a8b2c1);margin-bottom:0.6rem;">🎉 Recebeu uma proposta de emprego! Como prefere responder?</div>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                        <form asp-action="ApplicantRespond" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="response" value="1" />
                            <button type="submit" class="btn-primary-soft" style="background:#10b981;">🎉 Aceitar oferta</button>
                        </form>
                        <form asp-action="ApplicantRespond" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="response" value="2" />
                            <button type="submit" class="btn-danger-soft">✗ Recusar oferta</button>
                        </form>
                    </div>
                </div>
            }

            @* Employer actions *@
            @if (canManageAsEmployer && !isOwner && Model.Status != 5 && Model.Status != 4)
            {
                <div class="employer-action-section" style="width:100%;">
                    <div style="font-size:0.82rem;font-weight:700;color:var(--dark-text-muted,#a8b2c1);margin-bottom:0.75rem;">Ações do empregador</div>

                    @if (Model.Status == 0)
                    {
                        <form asp-action="EmployerAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="action" value="screen" />
                            <div class="notes-label">Notas internas (visíveis apenas para a equipa)</div>
                            <textarea name="notes" class="notes-textarea" placeholder="Ex: Candidato com bom perfil técnico, avançar para análise..."></textarea>
                            <div class="action-btn-group">
                                <button type="submit" class="btn-primary-soft" style="font-size:0.85rem;">🔍 Mover para Em Análise</button>
                            </div>
                        </form>
                    }
                    @if (Model.Status == 1)
                    {
                        <form asp-action="EmployerAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="action" value="interview" />
                            <div class="notes-label">Mensagem / notas para o candidato</div>
                            <textarea name="notes" class="notes-textarea" placeholder="Ex: Convidamos para entrevista na próxima semana. Aguardamos a sua confirmação..."></textarea>
                            <div class="action-btn-group">
                                <button type="submit" class="btn-primary-soft" style="background:#7c3aed;font-size:0.85rem;">🎤 Agendar Entrevista</button>
                            </div>
                        </form>
                    }
                    @if (Model.Status == 2 && Model.ApplicantResponse == 1)
                    {
                        <form asp-action="EmployerAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="action" value="offer" />
                            <div class="notes-label">Detalhes da oferta (salário, condições, benefícios...)</div>
                            <textarea name="notes" class="notes-textarea" placeholder="Ex: Oferecemos vencimento base de X€, regime híbrido, 25 dias de férias..."></textarea>
                            <div class="action-btn-group">
                                <button type="submit" class="btn-primary-soft" style="background:#059669;font-size:0.85rem;">🎉 Enviar Proposta</button>
                            </div>
                        </form>
                    }
                    @if (Model.Status == 3 && Model.ApplicantResponse == 1)
                    {
                        <form asp-action="EmployerAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="action" value="hire" />
                            <div class="notes-label">Data de início / notas de integração</div>
                            <textarea name="notes" class="notes-textarea" placeholder="Ex: Data de início prevista: 01/04/2026. HR irá contactar para onboarding..."></textarea>
                            <div class="action-btn-group">
                                <button type="submit" class="btn-primary-soft" style="background:#10b981;font-size:0.85rem;">✅ Confirmar Contratação</button>
                            </div>
                        </form>
                    }

                    @* Always available: reject *@
                    <div style="margin-top:1rem;padding-top:0.75rem;border-top:1px solid rgba(255,255,255,0.06);">
                        <form asp-action="EmployerAction" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.JobApplicationId" />
                            <input type="hidden" name="action" value="reject" />
                            <div class="notes-label">Motivo da rejeição (recomendado)</div>
                            <textarea name="notes" class="notes-textarea" style="min-height:55px;" placeholder="Ex: Candidato não preenche os requisitos mínimos para a função..."></textarea>
                            <div class="action-btn-group">
                                <button type="submit" class="btn-danger-soft" style="font-size:0.85rem;">✗ Rejeitar candidatura</button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @if (isAdmin)
            {
