@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <title>@ViewData["Title"] - Xcelerate Links</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/usermenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- React + ReactDOM for chat widget and other interactive components -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    @RenderSection("Head", required: false)
</head>

<body class="dark-theme">
    @{
        var homeController = "Home";
        var homeAction = "Index";
        var isAdmin = false;

        if (User?.Identity?.IsAuthenticated == true)
        {
            var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value;
            if (!string.IsNullOrEmpty(roleClaim) && roleClaim == "0")
            {
                isAdmin = true;
                homeAction = "AdminIndex";
            }
        }

        var isAuthPage = ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" &&
        (ViewContext.RouteData.Values["Action"]?.ToString() == "Login" ||
        ViewContext.RouteData.Values["Action"]?.ToString() == "Register");
    }

    @if (!isAuthPage)
    {
        <header class="site-header">
            <div class="container header-inner">
                <div class="header-left">
                    <a class="brand" asp-controller="@homeController" asp-action="@homeAction">
                        <img src="~/images/xcelerate-logo.png" alt="Xcelerate Links" />
                        <span class="brand-text">Xcelerate Links</span>
                    </a>
                </div>

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="header-center">
                        <form asp-controller="Opportunities" asp-action="Index" method="get" class="search-wrap">
                            <input name="q" class="search-input" type="search"
                                   placeholder="Pesquisar oportunidades..." />
                            <button class="search-btn" type="submit">🔍</button>
                        </form>
                    </div>
                }

                <div class="header-right">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {

                        @await Html.PartialAsync("_UserMenu")

                        <!-- Notification bell — visible to all authenticated users -->
                        <div id="notif-wrap" style="position:relative;display:inline-block;">
                            <button id="notif-bell-btn" class="btn-ghost" style="position:relative;" title="Notificações" aria-label="Notificações">
                                🔔<span id="notif-badge" aria-live="polite" style="display:none;position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;border-radius:50%;width:16px;height:16px;font-size:0.65rem;font-weight:700;align-items:center;justify-content:center;border:2px solid #0b1220;"></span>
                            </button>
                            <div id="notif-panel" style="display:none;position:absolute;right:0;top:calc(100% + 6px);width:340px;background:var(--bg-card,#1e2535);border-radius:10px;box-shadow:0 4px 24px rgba(0,0,0,0.32);z-index:9999;max-height:420px;overflow-y:auto;border:1px solid var(--border,#2a3147);">
                                <div style="padding:10px 16px;font-weight:700;border-bottom:1px solid var(--border,#2a3147);">Notificações</div>
                                <div id="notif-list"><div style="padding:16px;text-align:center;color:#888;">Sem notificações</div></div>
                            </div>
                        </div>

                        @if (isAdmin)
                        {
                            <a class="btn-filter" asp-controller="Home" asp-action="AdminIndex">Admin</a>
                            <a href="/Users/EmployerRequests" id="admin-req-btn" class="btn-ghost" style="position:relative;" title="Pedidos de Empregador">🔔<span id="admin-req-badge" style="display:none;position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;border-radius:50%;width:16px;height:16px;font-size:0.65rem;font-weight:700;align-items:center;justify-content:center;border:2px solid #0b1220;"></span></a>
                        }

                        <button id="langToggle" class="btn-ghost" title="Switch language">EN</button>
                        <button id="themeToggle" class="btn-ghost">🌙</button>
                    }
                    else
                    {
                        <button id="langToggle" class="btn-ghost" title="Switch language">EN</button>
                        <button id="themeToggle" class="btn-ghost">🌙</button>
                        <a class="btn-ghost" asp-controller="Account" asp-action="Login">Entrar</a>
                        <a class="btn-cta" asp-controller="Account" asp-action="Register">Criar Conta</a>
                    }
                </div>
            </div>
        </header>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h4>Sobre</h4>
                    <a href="#" class="footer-link">Sobre nós</a>
                    <a href="#" class="footer-link">Blog</a>
                    <a href="#" class="footer-link">Carreiras</a>
                </div>
                <div class="footer-section">
                    <h4>Recursos</h4>
                    <a href="#" class="footer-link">Documentação</a>
                    <a href="#" class="footer-link">Suporte</a>
                    <a href="#" class="footer-link">FAQ</a>
                </div>
                <div class="footer-section">
                    <h4>Legal</h4>
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link">Privacidade</a>
                    <a href="#" class="footer-link">Termos</a>
                    <a href="#" class="footer-link">Contacto</a>
                </div>
                <div class="footer-section">
                    <h4>Segue-nos</h4>
                    <a href="#" class="footer-link">Twitter</a>
                    <a href="#" class="footer-link">GitHub</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; @DateTime.UtcNow.Year Xcelerate Links. Todos os direitos reservados.</p>
            </div>
        </div>
    </footer>

    @RenderSection("Scripts", required: false)

    @await Html.PartialAsync("_ChatWidget")

    <script>
        const themeToggle = document.getElementById('themeToggle');
        const body = document.body;

        function setTheme(theme) {
            body.classList.remove('dark-theme', 'light-theme');
            body.classList.add(theme === 'dark' ? 'dark-theme' : 'light-theme');
            themeToggle.textContent = theme === 'dark' ? '☀️' : '🌙';
            localStorage.setItem('siteTheme', theme);
        }

        const savedTheme = localStorage.getItem('siteTheme') || 'dark';
        setTheme(savedTheme);

        themeToggle.addEventListener('click', () => {
            const currentTheme = body.classList.contains('dark-theme') ? 'dark' : 'light';
            setTheme(currentTheme === 'dark' ? 'light' : 'dark');
        });
    </script>
    @if (isAdmin)
    {
        <script>
            // Admin notification badge for pending employer requests
            (function() {
                function getToken() {
                    var m = document.cookie.split(';').map(function(c){return c.trim();}).find(function(c){return c.startsWith('ApiAccessToken=');});
                    return m ? decodeURIComponent(m.split('=')[1]) : (localStorage.getItem('token')||'');
                }
                function updateReqBadge() {
                    fetch('/api/users/pending-employers', {
                        headers: { 'Authorization': 'Bearer ' + getToken() }
                    }).then(function(r){ return r.json(); }).then(function(data) {
                        var badge = document.getElementById('admin-req-badge');
                        if (badge) {
                            if (data && data.length > 0) {
                                badge.style.display = 'flex';
                                badge.textContent = data.length > 9 ? '9+' : data.length;
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    }).catch(function(){});
                }
                document.addEventListener('DOMContentLoaded', function() { updateReqBadge(); });
                setInterval(updateReqBadge, 60000); // refresh every minute
            })();
        </script>
    }
    @if (User?.Identity?.IsAuthenticated == true)
    {
        <script>
            // Notification bell for authenticated users
            (function () {
                function getToken() {
                    var m = document.cookie.split(';').map(function (c) { return c.trim(); }).find(function (c) { return c.startsWith('ApiAccessToken='); });
                    return m ? decodeURIComponent(m.split('=')[1]) : (localStorage.getItem('token') || '');
                }

                function escapeHtml(str) {
                    return String(str)
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/"/g, '&quot;')
                        .replace(/'/g, '&#39;');
                }

                function renderNotifications(notifications) {
                    var list = document.getElementById('notif-list');
                    var badge = document.getElementById('notif-badge');
                    if (!list || !badge) return;
                    var unreadCount = notifications.filter(function (n) { return !n.isRead; }).length;
                    badge.dataset.count = String(unreadCount);
                    if (unreadCount > 0) {
                        badge.style.display = 'flex';
                        badge.textContent = unreadCount > 9 ? '9+' : String(unreadCount);
                    } else {
                        badge.style.display = 'none';
                    }
                    
                    // Clear existing items
                    while (list.firstChild) list.removeChild(list.firstChild);

                    if (notifications.length === 0) {
                        var empty = document.createElement('div');
                        empty.style.cssText = 'padding:16px;text-align:center;color:#888;';
                        empty.textContent = 'Sem notificações';
                        list.appendChild(empty);
                        return;
                    }
                    notifications.slice(0, 20).forEach(function (n) {
                        var icon = '🔔';
                        var text = '';
                        var link = '#';
                        try {
                            var payload = n.payload ? JSON.parse(n.payload) : {};
                            if (n.type === 'PerfectOpportunityMatch') {
                                icon = '⭐';
                                var title = payload.opportunityTitle ? ' \u201c' + escapeHtml(payload.opportunityTitle) + '\u201d' : '';
                                text = 'Tens uma correspond\u00eancia perfeita com a oportunidade' + title + '!';
                                if (payload.opportunityId) {
                                    link = '/Opportunities/Details/' + encodeURIComponent(payload.opportunityId);
                                }
                            } else if (n.type === 'JobApplied') {
                                icon = '📥';
                                text = 'Nova candidatura recebida.';
                                if (payload.applicationId) {
                                    link = '/Applications/Details/' + encodeURIComponent(payload.applicationId);
                                }
                            } else if (n.type === 'ApplicationStatusChanged') {
                                icon = '📋';
                                text = 'O estado da tua candidatura foi atualizado.';
                                if (payload.applicationId) {
                                    link = '/Applications/Details/' + encodeURIComponent(payload.applicationId);
                                }
                            } else {
                                text = escapeHtml(n.type);
                            }
                        } catch (e) {
                           text = escapeHtml(n.type || '');
                        }
                        var item = document.createElement('div');
                        item.dataset.notifId = String(n.notificationId);
                        item.dataset.notifLink = link;
                        item.style.cssText = 'padding:10px 16px;cursor:pointer;border-bottom:1px solid var(--border,#2a3147);';
                        if (!n.isRead) {
                            item.style.fontWeight = '600';
                            item.style.background = 'rgba(99,102,241,0.08)';
                        } else {
                            item.style.opacity = '0.6';
                        }
                        var iconSpan = document.createElement('span');
                        iconSpan.style.marginRight = '8px';
                        iconSpan.textContent = icon;
                        var textSpan = document.createElement('span');
                        textSpan.innerHTML = text;
                        var dateDiv = document.createElement('div');
                        dateDiv.style.cssText = 'font-size:0.75rem;color:#888;margin-top:2px;';
                        dateDiv.textContent = n.createdAt ? new Date(n.createdAt).toLocaleDateString('pt-PT') : '';
                item.appendChild(iconSpan);
                        item.appendChild(textSpan);
                        item.appendChild(dateDiv);
                        list.appendChild(item);
                    });
                }
                function markNotifRead(id, link, itemEl) {
                    var token = getToken();
                    fetch('/api/notifications/' + id + '/markread', {
                        method: 'POST',
                        headers: { 'Authorization': 'Bearer ' + token }
                    }).catch(function () {});
                    if (itemEl) {
                        itemEl.style.fontWeight = '';
                        itemEl.style.background = '';
                        itemEl.style.opacity = '0.6';
                    }
                    var badge = document.getElementById('notif-badge');
                    if (badge && badge.style.display !== 'none') {
                        var count = parseInt(badge.dataset.count || '0', 10);
                        if (count > 0) count--;
                        badge.dataset.count = String(count);
                        if (count === 0) {
                            badge.style.display = 'none';
                        } else {
                            badge.textContent = count > 9 ? '9+' : String(count);
                        }
                    }
                    if (link && link !== '#') window.location.href = link;
                }
                function loadNotifications() {
                    var token = getToken();
                    if (!token) return;
                    fetch('/api/notifications/my', {
                        headers: { 'Authorization': 'Bearer ' + token }
                    }).then(function (r) { return r.json(); }).then(function (data) {
                        renderNotifications(data);
                    }).catch(function () {});
                }
                document.addEventListener('DOMContentLoaded', function () {
                    loadNotifications();
                    setInterval(loadNotifications, 30000); // refresh every 30 s
                    
                    // Event delegation for notification item clicks
                    var list = document.getElementById('notif-list');
                    if (list) {
                        list.addEventListener('click', function (e) {
                            var item = e.target.closest('[data-notif-id]');
                            if (!item) return;
                            var id = parseInt(item.dataset.notifId, 10);
                            var link = item.dataset.notifLink || '#';
                            markNotifRead(id, link, item);
                        });
                    }
                    var btn = document.getElementById('notif-bell-btn');
                    var panel = document.getElementById('notif-panel');
                    if (btn && panel) {
                        btn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
                        });
                        document.addEventListener('click', function (e) {
                            if (panel && !panel.contains(e.target) && e.target !== btn) {
                                panel.style.display = 'none';
                            }
                        });
                    }
                });
            })();
        </script>
    }
    <script>
        (function() {
            // Scroll-reveal via IntersectionObserver
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('revealed');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

            function observeAll() {
                document.querySelectorAll('.scroll-reveal:not(.revealed)').forEach(function(el) {
                    observer.observe(el);
                });
                // Stagger children of grids
                document.querySelectorAll('.people-grid, .jobs-grid, .features-grid, .conn-grid').forEach(function(grid) {
                    var items = grid.querySelectorAll('.person-card, .job-card, .feature-card, .conn-card, .stat-card');
                    items.forEach(function(item, i) {
                        item.style.transitionDelay = (i * 0.06) + 's';
                        item.classList.add('scroll-reveal');
                        observer.observe(item);
                    });
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', observeAll);
            } else {
                observeAll();
            }

            // Counter animation for stat numbers (rAF-based for consistent speed)
            function animateCounter(el) {
                var target = parseInt(el.dataset.target || el.textContent, 10);
                if (isNaN(target) || target === 0) return;
                var duration = 1200;
                var startTime = null;
                function step(ts) {
                    if (!startTime) startTime = ts;
                    var progress = Math.min((ts - startTime) / duration, 1);
                    var ease = 1 - Math.pow(1 - progress, 3); // ease-out cubic
                    var current = Math.round(ease * target);
                    el.textContent = current.toLocaleString('pt-PT');
                    if (progress < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            }

            var counterObserver = new IntersectionObserver(function(entries) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        animateCounter(entry.target);
                        counterObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.5 });

            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('.stat-number[data-target]').forEach(function(el) {
                    counterObserver.observe(el);
                });
            });
        })();
    </script>

