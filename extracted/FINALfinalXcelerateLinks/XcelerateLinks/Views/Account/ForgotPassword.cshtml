@{
    ViewData["Title"] = "Recuperar Senha";
}
@section Styles {
    <style>
        .forgot-container {
            max-width: 400px;
            margin: 40px auto 0 auto;
            padding: 32px 28px 24px 28px;
            background: #f8fafd;
            border-radius: 14px;
            box-shadow: 0 2px 16px rgba(0,0,0,0.09);
        }

            .forgot-container h2 {
                margin-bottom: 22px;
            }

            .forgot-container label {
                font-weight: 600;
            }

            .forgot-container input[type="email"], .forgot-container input[type="text"] {
                margin-bottom: 12px;
                border-radius: 8px;
            }

        .btn-primary {
            display: block;
            width: 100%;
            margin-bottom: 18px;
            padding: 12px 0;
            border-radius: 8px;
            font-size: 1.1rem;
            background: #1270ea;
            transition: background .16s;
            box-shadow: 0 2px 18px rgba(0,0,0,0.05);
        }

            .btn-primary:hover, .btn-primary:focus {
                background: #0b4aa8;
            }

        .back-link-btn {
            display: inline-block;
            padding: 7px 20px;
            background: #e8f0ff;
            color: #174ea6 !important;
            border-radius: 7px;
            text-decoration: none;
            font-weight: 600;
            transition: background .14s, color .14s;
        }

            .back-link-btn:hover, .back-link-btn:focus {
                background: #cddffb;
                color: #063374 !important;
                text-decoration: none;
            }
        @@media (max-width: 600px) {
            .forgot-container

        {
            padding: 18px 8px 18px 8px;
            margin: 14px;
        }

        }
    </style>
}

<div class="forgot-container">
    <h2>Recuperar Senha</h2>
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">@ViewBag.Message</div>
    }
    else
    {
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label for="email" class="form-label">O Seu Email</label>
                <input class="form-control" type="email" name="email" required autocomplete="email" />
            </div>
            <button type="submit" class="btn btn-primary">Enviar Link de Recuperação</button>
        </form>
    }

    <a href="/Account/Login" class="back-link-btn mt-1">Voltar ao login</a>
</div>