@model IEnumerable<APIPSI16.Models.Opportunity>
@using XcelerateLinks.Mvc.Controllers
@{
    ViewData["Title"] = "Oportunidades de Emprego";
    var employmentTypes = new Dictionary<byte, string> { {1,"Full-Time"},{2,"Part-Time"},{3,"Contract"},{4,"Internship"},{5,"Freelance"} };
    var remoteOptions = new Dictionary<byte, string> { {0,"No local"},{1,"Híbrido"},{2,"Remoto"} };
    var opportunityTypeBadges = new Dictionary<byte,(string label,string borderColor,string textColor)>
    {
        {1, ("Acompanhada 🟡","rgba(255,200,0,0.4)","#ffc800")},
        {2, ("Longa Duração 🔵","rgba(0,120,255,0.4)","#4f8ef7")}
    };
    var oppsWithMatch = ViewBag.OpportunitiesWithMatch as List<OpportunityWithMatch>;
    var locationsList = ViewBag.Locations as IEnumerable<UsersController.LookupItem> ?? Enumerable.Empty<UsersController.LookupItem>();
}

<style>
    .jobs-hero {
        background: linear-gradient(135deg, rgba(0,82,204,0.12), rgba(0,221,85,0.06));
        border-radius: 16px;
        padding: 2.5rem 2rem;
        margin-bottom: 2rem;
    }
    .jobs-hero h1 { font-size: 1.9rem; font-weight: 800; margin-bottom: 0.4rem; }
    .jobs-hero p { color: var(--dark-text-muted,#a8b2c1); margin: 0; }

    .jobs-search-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.5rem; }
    .jobs-search-row .form-control,
    .jobs-search-row .form-select {
        background: rgba(255,255,255,0.06); color: inherit;
        border-color: rgba(255,255,255,0.12);
    }
    .jobs-search-row .form-control:focus,
    .jobs-search-row .form-select:focus { background: rgba(255,255,255,0.1); box-shadow: none; border-color:#0052CC; color: inherit; }
    .jobs-search-row .form-select option { background: #141829; }

    .jobs-layout { display: grid; grid-template-columns: 300px 1fr; gap: 1.5rem; }
    @@media (max-width:768px) { .jobs-layout { grid-template-columns: 1fr; } }

    .jobs-sidebar {}
    .jobs-sidebar .filter-card { background: rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 1.2rem; margin-bottom: 1rem; }
    .jobs-sidebar .filter-card h5 { font-size: 0.9rem; font-weight: 700; margin-bottom: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--dark-text-muted,#a8b2c1); }
    .filter-option { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0; cursor: pointer; }
    .filter-option input { accent-color: #0052CC; }

    .jobs-list { display: flex; flex-direction: column; gap: 1rem; }

    .job-card {
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 1.4rem;
        transition: border-color 0.2s, transform 0.2s;
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }
    .job-card:hover { border-color: rgba(0,82,204,0.4); transform: translateY(-2px); }

    .job-logo {
        width: 52px; height: 52px; border-radius: 10px;
        background: linear-gradient(135deg, rgba(0,82,204,0.2), rgba(0,221,85,0.1));
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; flex-shrink: 0;
    }

    .job-info { flex: 1; min-width: 0; }
    .job-title { font-size: 1.05rem; font-weight: 700; color: inherit; text-decoration: none; }
    .job-title:hover { color: #0052CC; }
    .job-company { font-size: 0.87rem; color: var(--dark-text-muted,#a8b2c1); margin: 0.15rem 0; }
    .job-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.6rem; }
    .job-tag { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 30px; padding: 0.18rem 0.65rem; font-size: 0.75rem; }
    .job-tag.remote { border-color: rgba(0,221,85,0.3); color: #00DD55; background: rgba(0,221,85,0.06); }

    .job-actions { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-end; flex-shrink: 0; }
    .btn-apply { background: #0052CC; color: #fff; border: none; border-radius: 30px; padding: 0.45rem 1.1rem; font-size: 0.85rem; white-space: nowrap; text-decoration: none; }
    .btn-apply:hover { background: #0040A0; color: #fff; }
    .btn-save { background: transparent; border: 1px solid rgba(255,255,255,0.15); color: inherit; border-radius: 30px; padding: 0.4rem 0.9rem; font-size: 0.82rem; }

    .results-count { font-size: 0.85rem; color: var(--dark-text-muted,#a8b2c1); margin-bottom: 1rem; }

    .no-results { text-align: center; padding: 4rem 2rem; color: var(--dark-text-muted,#a8b2c1); }
</style>

<div class="container py-4">
    <div class="jobs-hero">
        <h1>💼 Oportunidades</h1>
        <p>Encontra o teu próximo desafio profissional.</p>

        <form asp-action="Index" method="get" class="jobs-search-row">
            <input type="search" name="q" class="form-control" style="flex:2;min-width:180px;"
                   placeholder="Cargo, empresa ou palavra-chave..." value="@ViewBag.Q" />
            <select name="locationId" class="form-select" style="flex:1;min-width:140px;" id="locationFilterSelect">
                <option value="">Localização...</option>
                @foreach (var loc in locationsList)
                {
                    var selLoc = (ViewBag.LocationId is int lid && lid == loc.LocationId) ? "selected" : "";
                    if (selLoc == "selected")
                    {
                        <option value="@loc.LocationId" selected>@loc.Name (@loc.CountryName)</option>
                    }
                    else
                    {
                        <option value="@loc.LocationId">@loc.Name (@loc.CountryName)</option>
                    }
                }
            </select>
            <select name="employmentType" class="form-select" style="flex:1;min-width:140px;">
                <option value="">Tipo de emprego</option>
                @foreach (var kv in employmentTypes)
                {
                    var sel = (ViewBag.EmploymentType is byte b && b == kv.Key) ? "selected" : "";
                    if (sel == "selected")
                    {
                        <option value="@kv.Key" selected>@kv.Value</option>
                    }
                    else
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                }
            </select>
            <select name="remoteOption" class="form-select" style="flex:1;min-width:120px;">
                <option value="">Modalidade</option>
                @foreach (var kv in remoteOptions)
                {
                    var sel = (ViewBag.RemoteOption is byte r && r == kv.Key) ? "selected" : "";
                    if (sel == "selected")
                    {
                        <option value="@kv.Key" selected>@kv.Value</option>
                    }
                    else
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                }
            </select>
            <button type="submit" class="btn btn-primary px-4">Pesquisar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </form>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">@ViewBag.Error</div>
    }

    @{
        var list = Model.ToList();
        var recommended = ViewBag.RecommendedList as IEnumerable<APIPSI16.Models.Opportunity>;
        var isRecommended = ViewBag.Recommended == true;
    }

    <!-- Tabs: Todas | Para Ti -->
    <div style="display:flex;gap:0.25rem;margin-bottom:1.5rem;border-bottom:1px solid rgba(255,255,255,0.08);">
        <a href="@Url.Action("Index","Opportunities", new { q=ViewBag.Q, locationId=ViewBag.LocationId, employmentType=ViewBag.EmploymentType, remoteOption=ViewBag.RemoteOption })"
           style="padding:0.5rem 1.25rem;font-size:0.88rem;font-weight:600;text-decoration:none;border-bottom:2px solid @(isRecommended ? "transparent" : "#0052CC");color:@(isRecommended ? "var(--dark-text-muted,#a8b2c1)" : "#4f8ef7");margin-bottom:-1px;">
            Todas
        </a>
        <a href="@Url.Action("Index","Opportunities", new { q=ViewBag.Q, locationId=ViewBag.LocationId, recommended=true })"
           style="padding:0.5rem 1.25rem;font-size:0.88rem;font-weight:600;text-decoration:none;border-bottom:2px solid @(isRecommended ? "#0052CC" : "transparent");color:@(isRecommended ? "#4f8ef7" : "var(--dark-text-muted,#a8b2c1)");margin-bottom:-1px;">
            ⭐ Para Ti
        </a>
    </div>

    @if (isRecommended && recommended != null)
    {
        list = recommended.ToList();
    }

    <p class="results-count">@list.Count oportunidade(s) encontrada(s)</p>

    @if (!list.Any())
    {
        <div class="no-results">
            <p>🔍 Nenhuma oportunidade encontrada para os filtros aplicados.</p>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">Ver todas as oportunidades</a>
        </div>
    }
    else
    {
        <div class="jobs-list">
            @foreach (var item in list)
            {
                var empLabel = (item.EmploymentType.HasValue && employmentTypes.ContainsKey(item.EmploymentType.Value))
                    ? employmentTypes[item.EmploymentType.Value] : null;
                var remLabel = (item.RemoteOption.HasValue && remoteOptions.ContainsKey(item.RemoteOption.Value))
                    ? remoteOptions[item.RemoteOption.Value] : null;

                var matchItem = oppsWithMatch?.FirstOrDefault(m => m.Id == item.Id);
                var matchScore = matchItem?.MatchScore ?? 0;
                var matchColor = matchScore >= 75 ? "#00DD55" : matchScore >= 40 ? "#f59e0b" : "#6b7280";

                <div class="job-card">
                    <div class="job-logo">🏢</div>
                    <div class="job-info">
                        <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
                            <a asp-action="Details" asp-route-id="@item.Id" class="job-title">@(item.Title ?? "Oportunidade")</a>
                            @if (matchScore > 0)
                            {
                                <span style="font-size:0.72rem;font-weight:700;background:@(matchColor + "1A");border:1px solid @(matchColor + "55");color:@matchColor;border-radius:20px;padding:0.15rem 0.55rem;white-space:nowrap;">
                                    @matchScore% match
                                </span>
                            }
                        </div>
                        @if (matchItem?.CompanyName != null)
                        {
                            <p class="job-company">@matchItem.CompanyName</p>
                        }
                        else if (item.Company != null || item.CompanyId.HasValue)
                        {
                            <p class="job-company">@(item.Company?.Name ?? $"Empresa #{item.CompanyId}")</p>
                        }
                        <div class="job-tags">
                            @{
                                var locationDisplay = matchItem?.LocationName ?? matchItem?.Location ?? item.Location;
                                var countryDisplay = matchItem?.CountryName;
                            }
                            @if (!string.IsNullOrEmpty(locationDisplay))
                            {
                                <span class="job-tag">📍 @locationDisplay@(countryDisplay != null ? $", {countryDisplay}" : "")</span>
                            }
                            @if (empLabel != null)
                            {
                                <span class="job-tag">⏱ @empLabel</span>
                            }
                            @if (remLabel != null)
                            {
                                <span class="job-tag remote">🌐 @remLabel</span>
                            }
                            @{
                                var oppType = matchItem?.OpportunityType;
                                if (oppType.HasValue && opportunityTypeBadges.ContainsKey(oppType.Value))
                                {
                                    var badge = opportunityTypeBadges[oppType.Value];
                                    <span class="job-tag" style="border-color:@badge.borderColor;color:@badge.textColor;">@badge.label</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="job-actions">
                        <a asp-controller="Applications" asp-action="Create" asp-route-opportunityId="@item.Id" class="btn-apply">Candidatar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-save">Ver mais</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
// Searchable location filter combobox
(function() {
    var sel = document.getElementById('locationFilterSelect');
    if (!sel) return;
    var input = document.createElement('input');
    input.type = 'text';
    input.placeholder = 'Pesquisar localização...';
    input.style.cssText = 'background:rgba(255,255,255,0.06);color:inherit;border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:0.3rem 0.6rem;font-size:0.82rem;width:100%;margin-bottom:2px;';
    sel.parentNode.insertBefore(input, sel);
    input.addEventListener('input', function() {
        var q = this.value.toLowerCase();
        Array.from(sel.options).forEach(function(opt) {
            if (!opt.value) { opt.style.display = ''; return; }
            opt.style.display = opt.text.toLowerCase().includes(q) ? '' : 'none';
        });
    });
})();
</script>
}
